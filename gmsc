#!/system/bin/sh

ID="$(id -u)"
GMS="com.google.android.gms"
NULL="/dev/null"

contains_gms() {
  grep -qE "(^|[,[:space:]])$GMS([,[:space:]]|$)"
}

is_whitelisted() {
  dumpsys deviceidle whitelist 2>"$NULL" | contains_gms && return 0
  dumpsys deviceidle sys-whitelist 2>"$NULL" | contains_gms && return 0
  dumpsys deviceidle except-idle-whitelist 2>"$NULL" | contains_gms && return 0
  return 1
}

if [ "$ID" != "0" ]; then
  echo -e "\033[1;33m 需要 Superuser（su）权限！\033[0m"
  exit 1
fi

if is_whitelisted; then
  echo -e "\033[1;31m Google Play 服务未优化。\033[0m"
else
  echo -e "\033[1;32m Google Play 服务已优化。\033[0m"
fi
